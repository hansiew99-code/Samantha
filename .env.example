# ── Required for day-one operation ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
TELEGRAM_BOT_TOKEN=123456:ABC-...        # from @BotFather
TELEGRAM_CHAT_ID=123456789               # your own chat id — messages from anyone else are ignored

# ── Optional integrations (leave blank to disable — Samantha runs without them) ──
# Google: run `python scripts/setup_auth.py` once after placing the OAuth client
# JSON at GOOGLE_CREDENTIALS_PATH; it writes the refresh token to GOOGLE_TOKEN_PATH.
GOOGLE_CREDENTIALS_PATH=google_credentials.json
GOOGLE_TOKEN_PATH=google_token.json

# Google Chat (reads your DMs/rooms so she can flag when people message you).
# Needs the Chat API enabled + a token re-consented with the chat.*.readonly
# scopes (see SETUP_POWERS). Off until you flip this to 1.
GCHAT_ENABLED=0
GCHAT_SELF_ID=                           # required when enabled; format: users/<id>

SLACK_BOT_TOKEN=                         # xoxb-... (chat:write, app_mentions:read, im:history)
SLACK_APP_TOKEN=                         # xapp-... (Socket Mode enabled)

CLICKUP_API_TOKEN=                       # personal API token
CLICKUP_TEAM_ID=                         # workspace/team id

# ── Behavior ────────────────────────────────────────────────────────────────
SAMANTHA_DB_PATH=samantha.db
SAMANTHA_TIMEZONE=Asia/Kuala_Lumpur
SAMANTHA_DAILY_BUDGET_USD=0.177          # ≈ RM25/month
SAMANTHA_QUIET_HOURS=23:00-07:00

# Proactive cadence: she pulls (inbox/chat triage + calendar look-ahead) this
# often, but only inside the working window — off-hours she rests and the
# evening brief mops up. Default: every 30 min, Mon–Fri, 8am–7pm.
SAMANTHA_WORK_DAYS=mon-fri               # mon-fri | mon-sun | mon,wed,fri
SAMANTHA_WORK_HOURS=8-19                 # 24h, end exclusive (8am–7pm)
SAMANTHA_PROACTIVE_INTERVAL_MIN=30

# Briefs: morning + afternoon on working days, evening every night.
SAMANTHA_MORNING_DIGEST=09:00
SAMANTHA_AFTERNOON_DIGEST=14:00
SAMANTHA_EVENING_DIGEST=21:00
SAMANTHA_DRY_RUN=0                       # 1 = never send anything outbound, log instead
